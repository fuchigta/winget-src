# packages.yaml の設定例
# PACKAGE_LIST=/path/to/packages.yaml として環境変数に指定して使用します
#
# 【id フィールドについて】
# id は GitHub/GitLab の owner/repo 形式で指定します。
# WinGet に返す PackageIdentifier は id の "/" を "." に自動変換した値になります。
# 例: id: fuchigta/cc-launcher → PackageIdentifier: fuchigta.cc-launcher
# winget search や winget install では変換後のドット形式の identifier を使用してください。

# GitHub プロバイダーの例（MSI形式）— アセット名に "windows" を含まないケース
# cc-launcher のアセット名は `cc-launcher_<VERSION>_x64_ja-JP.msi` 形式のため、
# アーキテクチャキーワード（x64）による自動検出が適用される
- provider: github
  id: fuchigta/cc-launcher
  name: CC Launcher
  publisher: fuchigta
  description: Windows system tray app for quick access to Claude Code via global keyboard shortcut
  token: ""
  installer_type: msi
  license: MIT
  locale: ja-JP
  upgrade_behavior: install       # install または uninstallPrevious（省略時: install）
  # architecture: x64            # アーキテクチャの明示指定: x64 / x86 / arm64（省略時: ファイル名から自動検出、検出不可時は x64）
  # product_code: "{XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}"  # MSI の ProductCode GUID（任意）

# GitHub プロバイダーの例（zip-portable形式）
